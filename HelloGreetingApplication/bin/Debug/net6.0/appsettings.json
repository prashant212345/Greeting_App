{
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Warning"
        }
    },
    "AllowedHosts": "*",
    "ConnectionStrings": {
        "DefaultConnection": "Server=PB\\SQLEXPRESS;Database=GreetingApp;Trusted_Connection=True;"
    },
    "Jwt": {
        "Secret": "Your_Secret_Key_1234567890aaaaaaaaaaaa",
        "Issuer": "yourdomain.com",
        "Audience": "yourdomain.com"
    },
    "NLog": {
        "targets": {
            "file": {
                "type": "File",
                "fileName": "logs/logfile.log",
                "layout": "${longdate} ${level} ${message} ${exception}"
            }
        },
        "rules": [
            {
                "logger": "*",
                "minLevel": "Info",
                "writeTo": "file"
            }
        ]
    }
}
