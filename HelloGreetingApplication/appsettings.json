{
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Warning"
        }
    },
    "AllowedHosts": "*",
    "NLog": {
        "targets": {
            "file": {
                "type": "File",
                "fileName": "logs/logfile.log",
                "layout": "${longdate} ${level} ${message} ${exception}"
            }
        },
        "rules": [
            {
                "logger": "*",
                "minLevel": "Info",
                "writeTo": "file"
            }
        ]
    }
}
